{
  "functions": [
    {
      "source": "apps/functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.local", "package.json.workspace", "src"],
      "predeploy": [
        "node scripts/prepare-functions-vendor.mjs",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "postdeploy": ["node scripts/restore-functions-package.mjs"]
    }
  ],
  "firestore": [
    {
      "database": "codehero",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": [
    {
      "target": "codehero",
      "rules": "storage.rules"
    }
  ],
  "hosting": {
    "site": "codehero",
    "public": "apps/web/out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/downloads/**", "destination": "/downloads/**" }
    ],
    "headers": [
      {
        "source": "/downloads/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
