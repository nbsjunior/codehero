{
  "functions": [
    {
      "source": "apps/functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.local", "package.json.workspace", "src"],
      "predeploy": [
        "node scripts/prepare-functions-vendor.mjs",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "postdeploy": ["node scripts/restore-functions-package.mjs"]
    }
  ],
  "firestore": [
    {
      "database": "codehero",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": [
    {
      "target": "codehero",
      "rules": "storage.rules"
    }
  ],
  "hosting": {
    "site": "codehero",
    "public": "apps/web/out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": true,
    "rewrites": [
      { "source": "/downloads/**", "destination": "/downloads/**" },
      { "source": "/*/githubOauthCallback", "function": { "functionId": "githubOAuthCallback", "region": "us-central1" } },
      { "source": "/api/ingestAnalysis", "function": { "functionId": "ingestAnalysis", "region": "us-central1" } },
      { "source": "/api/getActiveRules", "function": { "functionId": "getActiveRules", "region": "us-central1" } },
      { "source": "/api/getRulesCatalog", "function": { "functionId": "getRulesCatalog", "region": "us-central1" } },
      { "source": "/api/listIssues", "function": { "functionId": "listIssues", "region": "us-central1" } },
      { "source": "/api/sddSpec", "function": { "functionId": "sddSpec", "region": "us-central1" } },
      { "source": "/api/submitFixResult", "function": { "functionId": "submitFixResult", "region": "us-central1" } }
    ],
    "headers": [
      {
        "source": "/downloads/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/_next/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.cloudfunctions.net https://*.web.app https://api.github.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
