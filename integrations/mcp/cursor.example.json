{
  "mcpServers": {
    "codehero": {
      "command": "npx",
      "args": ["hero-mcp"],
      "env": {
        "HERO_CORE_URL": "http://127.0.0.1:5001/<project>/us-central1",
        "HERO_TOKEN": "<ingest-token>",
        "HERO_ORG_ID": "<orgId>",
        "HERO_PROJECT_ID": "<projectId>",
        "HERO_SCANNER_CMD": "npx hero-scan"
      }
    }
  }
}
