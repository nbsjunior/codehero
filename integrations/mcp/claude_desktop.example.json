{
  "mcpServers": {
    "codehero": {
      "command": "npx",
      "args": ["-y", "codehero-mcp@latest"],
      "env": {
        "HERO_CORE_URL": "https://codehero.web.app/api",
        "HERO_TOKEN": "<ingest-token>",
        "HERO_ORG_ID": "<orgId>",
        "HERO_PROJECT_ID": "<projectId>",
        "HERO_REPO_ID": "<repoId>"
      }
    }
  }
}
