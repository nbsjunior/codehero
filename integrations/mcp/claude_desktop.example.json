{
  "mcpServers": {
    "codehero": {
      "command": "node",
      "args": ["./packages/mcp/dist/server.js"],
      "env": {
        "HERO_CORE_URL": "https://codehero.web.app/api",
        "HERO_TOKEN": "<ingest-token>",
        "HERO_ORG_ID": "<orgId>",
        "HERO_PROJECT_ID": "<projectId>",
        "HERO_REPO_ID": "<repoId>",
        "HERO_SCANNER_CMD": "node ./packages/scanner/dist/index.js"
      }
    }
  }
}
