{
  "name": "codehero-ide",
  "displayName": "CodeHero",
  "description": "Scan determinístico no editor: regras padrão + AST + taint, painel de avaliação e Problems.",
  "version": "0.2.1",
  "private": true,
  "publisher": "codehero",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codehero",
          "title": "CodeHero",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "codehero": [
        {
          "id": "codehero.findings",
          "name": "Avaliação"
        }
      ]
    },
    "commands": [
      {
        "command": "codehero.scanWorkspace",
        "title": "CodeHero: Rodar scan no workspace",
        "icon": "$(play)"
      },
      {
        "command": "codehero.scanFile",
        "title": "CodeHero: Rodar scan no arquivo atual",
        "icon": "$(file)"
      },
      {
        "command": "codehero.clearFindings",
        "title": "CodeHero: Limpar findings",
        "icon": "$(clear-all)"
      },
      {
        "command": "codehero.showDashboard",
        "title": "CodeHero: Ver dashboard (gráficos e compliance)",
        "icon": "$(graph)"
      },
      {
        "command": "codehero.openSettings",
        "title": "CodeHero: Abrir configurações",
        "icon": "$(gear)"
      },
      {
        "command": "codehero.showHowTo",
        "title": "CodeHero: Como usar",
        "icon": "$(question)"
      },
      {
        "command": "codehero.openFinding",
        "title": "CodeHero: Abrir finding"
      },
      {
        "command": "codehero.copyFinding",
        "title": "CodeHero: Copiar finding"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codehero.scanWorkspace",
          "when": "view == codehero.findings",
          "group": "navigation@1"
        },
        {
          "command": "codehero.scanFile",
          "when": "view == codehero.findings",
          "group": "navigation@2"
        },
        {
          "command": "codehero.clearFindings",
          "when": "view == codehero.findings",
          "group": "navigation@3"
        },
        {
          "command": "codehero.showDashboard",
          "when": "view == codehero.findings",
          "group": "navigation@4"
        },
        {
          "command": "codehero.openSettings",
          "when": "view == codehero.findings",
          "group": "navigation@5"
        },
        {
          "command": "codehero.showHowTo",
          "when": "view == codehero.findings",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "codehero.copyFinding",
          "when": "view == codehero.findings && viewItem == codeheroFinding"
        }
      ]
    },
    "configuration": {
      "title": "CodeHero",
      "properties": {
        "codehero.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Ao salvar um arquivo, roda o scan determinístico só nesse arquivo."
        },
        "codehero.enableCache": {
          "type": "boolean",
          "default": true,
          "description": "Usa cache incremental do scanner (mais rápido em workspaces grandes)."
        },
        "codehero.minSeverity": {
          "type": "string",
          "default": "INFO",
          "enum": [
            "INFO",
            "MINOR",
            "MAJOR",
            "CRITICAL",
            "BLOCKER"
          ],
          "description": "Severidade mínima exibida no painel e no Problems."
        },
        "codehero.scannerCommand": {
          "type": "string",
          "default": "",
          "markdownDescription": "Deixe **vazio** (recomendado) para o scanner embutido no VSIX. Não use `npx hero-scan` — esse pacote não existe no npm. Só preencha com um caminho absoluto a um CLI próprio que aceite `--sarif`."
        },
        "codehero.orgId": {
          "type": "string",
          "default": "",
          "description": "ID da organização no portal (opcional — para correlacionar com o projeto CodeHero)."
        },
        "codehero.projectId": {
          "type": "string",
          "default": "",
          "description": "ID do projeto no portal (opcional)."
        },
        "codehero.serverUrl": {
          "type": "string",
          "default": "https://codehero.web.app/api",
          "description": "URL base das Cloud Functions (getActiveRules). O plugin busca as regras aqui antes de cada scan."
        },
        "codehero.token": {
          "type": "string",
          "default": "",
          "description": "Token de ingestão do projeto (necessário para dress code / overlays do projeto)."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle:scanner": "node ./scripts/bundle-scanner.mjs",
    "package": "npm run bundle:scanner && npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository -o ../../apps/web/public/downloads/codehero-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.2"
  }
}
