{
  "name": "codehero-ide",
  "displayName": "CodeHero",
  "description": "Static analysis with verifiable SDD fixes — runs hero-scanner (pattern + AST + taint).",
  "version": "0.1.0",
  "private": true,
  "publisher": "codehero",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Linters"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "codehero.scanWorkspace", "title": "CodeHero: Scan Workspace" },
      { "command": "codehero.scanFile", "title": "CodeHero: Scan Current File" },
      { "command": "codehero.copySddHint", "title": "CodeHero: Copy MCP Fix Hint" }
    ],
    "configuration": {
      "title": "CodeHero",
      "properties": {
        "codehero.scanOnSave": { "type": "boolean", "default": true },
        "codehero.scannerCommand": {
          "type": "string",
          "default": "npx hero-scan",
          "description": "CLI used to scan (must support --sarif)."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository -o ../../apps/web/public/downloads/codehero-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.2"
  }
}
