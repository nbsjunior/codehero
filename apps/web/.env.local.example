# Firebase web client (local / CI). Copy to `.env.local` — never commit real values.
#
# Emulators: set NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true (demo fallbacks apply).
# Production: set false and fill every NEXT_PUBLIC_* from your Firebase Console
# (Project settings → Your apps). Use the CodeHero named Firestore database
# and dedicated Storage bucket — not another app's default resources.

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional: reCAPTCHA v3 site key for Firebase App Check (requires ENFORCE_APP_CHECK=true on Functions).
# NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
