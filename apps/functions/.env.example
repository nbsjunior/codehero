# Runtime env for Cloud Functions (local: apps/functions/.env — gitignored).
# Production: Firebase console / CI-mounted .env at deploy time.

# When true, browser callables that opt into portalCallableOpts reject missing App Check.
# Pair with NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY on the web app.
ENFORCE_APP_CHECK=false

FIRESTORE_DATABASE_ID=codehero
# FIREBASE_STORAGE_BUCKET=apponti-codehero
