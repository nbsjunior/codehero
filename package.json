{
  "name": "codehero",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "CodeHero — AI-optimized static analysis & remediation (open source engine + integrations)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/functions",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scan": "node packages/scanner/src/index.ts",
    "build:contracts": "npm run build -w @codehero/contracts",
    "build:engine": "npm run build -w @codehero/engine",
    "build:scanner": "npm run build -w @codehero/scanner",
    "build:ruleforge": "npm run build -w @codehero/ruleforge",
    "build:mcp": "npm run build -w codehero-mcp",
    "build:ide": "npm run build -w codehero-ide",
    "package:ide": "npm run package -w codehero-ide",
    "build:functions": "npm run build -w @codehero/functions",
    "build:deploy": "npm run build:contracts && npm run build:engine && npm run build:ruleforge && npm run build:fp-ranker && npm run build:functions",
    "build": "npm run build:contracts && npm run build:engine && npm run build:cpg && npm run build:fp-ranker && npm run build:code-embed && npm run build:scanner && npm run build:ruleforge && npm run build:mcp && npm run build:ide && npm run build:functions",
    "build:locksmith": "npm run build -w @codehero/locksmith",
    "locksmith": "node packages/locksmith/dist/cli.js",
    "test:engine": "npm run test -w @codehero/engine",
    "test": "npm run sonar:check && npm run test:contracts && npm run test:ranker && npm run test:code-embed && npm run test:scanner && npm run test:ruleforge && npm run test:engine && npm run test:functions && npm run benchmark",
    "test:functions": "npm run test -w @codehero/functions",
    "emulators": "firebase emulators:start",
    "dev:web": "npm run dev -w @codehero/web",
    "ruleforge:evaluate": "npm run evaluate -w @codehero/ruleforge",
    "ruleforge:evolve-all": "node packages/ruleforge/src/cli.ts evolve-all",
    "sonar:fetch": "node scripts/fetch-sonar-way.mjs",
    "sonar:generate": "node scripts/generate-sonar-way-rules.mjs",
    "sonar:compare": "node scripts/compare-sonar-way.mjs",
    "sonar:engenharia": "node scripts/sonar-way-engenharia.mjs",
    "cve:mine": "node scripts/mine-cve-fixes.mjs",
    "fp-ranker:train": "npm run train -w @codehero/fp-ranker",
    "build:cpg": "npm run build -w @codehero/cpg-joern",
    "build:fp-ranker": "npm run build -w @codehero/fp-ranker",
    "build:code-embed": "npm run build -w @codehero/code-embed",
    "code-embed:cluster": "npm run cluster -w @codehero/code-embed --",
    "test:contracts": "npm run test --workspace=@codehero/contracts",
    "test:ranker": "npm run test --workspace=@codehero/fp-ranker",
    "test:code-embed": "npm run test --workspace=@codehero/code-embed",
    "test:scanner": "npm run test --workspace=@codehero/scanner",
    "fp:train": "node packages/fp-ranker/scripts/train.mjs",
    "cve:promote": "node scripts/cve-promote.mjs",
    "sonar:curation": "node scripts/extract-sonar-curation.mjs",
    "sonar:live": "node scripts/build-sonar-live.mjs",
    "sonar:check": "node scripts/build-sonar-live.mjs --check",
    "test:ruleforge": "npm run test -w @codehero/ruleforge",
    "corpus:mine": "node scripts/mine-characterization.mjs .",
    "corpus:check": "node scripts/mine-characterization.mjs . --check",
    "benchmark": "node scripts/benchmark-gate.mjs",
    "benchmark:gravar": "node scripts/benchmark-gate.mjs --gravar",
    "test:smoke": "node scripts/smoke-portal.mjs",
    "test:smoke:deep": "node scripts/smoke-portal.mjs --deep"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "overrides": {
    "hono": "4.13.0",
    "@hono/node-server": "2.1.0",
    "fast-uri": "3.1.5",
    "brace-expansion": "2.1.4",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "uuid": "11.1.1"
  }
}
