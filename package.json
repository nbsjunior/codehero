{
  "name": "codehero",
  "version": "0.1.0",
  "private": true,
  "description": "CodeHero — AI-optimized static analysis & remediation SaaS on Firebase",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/functions",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scan": "node packages/scanner/src/index.ts",
    "build:contracts": "npm run build -w @codehero/contracts",
    "build:engine": "npm run build -w @codehero/engine",
    "build:scanner": "npm run build -w @codehero/scanner",
    "build:ruleforge": "npm run build -w @codehero/ruleforge",
    "build:mcp": "npm run build -w @codehero/mcp",
    "build:ide": "npm run build -w codehero-ide",
    "package:ide": "npm run package -w codehero-ide",
    "build:functions": "npm run build -w @codehero/functions",
    "build": "npm run build:contracts && npm run build:engine && npm run build:cpg && npm run build:fp-ranker && npm run build:scanner && npm run build:ruleforge && npm run build:mcp && npm run build:ide && npm run build:functions",
    "build:locksmith": "npm run build -w @codehero/locksmith",
    "locksmith": "node packages/locksmith/dist/cli.js",
    "test:engine": "npm run test -w @codehero/engine",
    "test": "npm run test:contracts && npm run test:ranker && npm run test:engine",
    "emulators": "firebase emulators:start",
    "dev:web": "npm run dev -w @codehero/web",
    "ruleforge:evaluate": "npm run evaluate -w @codehero/ruleforge",
    "ruleforge:evolve-all": "node packages/ruleforge/src/cli.ts evolve-all",
    "sonar:fetch": "node scripts/fetch-sonar-way.mjs",
    "sonar:generate": "node scripts/generate-sonar-way-rules.mjs",
    "sonar:compare": "node scripts/compare-sonar-way.mjs",
    "cve:mine": "node scripts/mine-cve-fixes.mjs",
    "fp-ranker:train": "npm run train -w @codehero/fp-ranker",
    "build:cpg": "npm run build -w @codehero/cpg-joern",
    "build:fp-ranker": "npm run build -w @codehero/fp-ranker",
    "test:contracts": "npm run test --workspace=@codehero/contracts",
    "test:ranker": "npm run test --workspace=@codehero/fp-ranker"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
