rules_version = '2';

// CodeHero — multi-tenant SaaS security model (projeto compartilhado "YOUR_CLOUD_PROJECT_ID").
//
// CANONICAL deploy source for production rules is the [redacted] repo
// (firestore.rules), which merges these CodeHero paths with the default-deny
// used by OTHER_APP. Do NOT `firebase deploy --only firestore:rules` from this
// repo alone — it would wipe the sibling app ruleset. See docs/ARCHITECTURE.md.
//
// Access is scoped per organization. A user may only read/write data of orgs
// they are a member of. All writes to analysis/issue data go through Cloud
// Functions with the Admin SDK (which bypasses these rules), so the client
// rules are intentionally read-mostly.
//
// Platform admins (documented in platformAdmins/{uid}) are a separate,
// narrow escape hatch: they can READ across every org/project (for the
// global admin dashboard) but never WRITE — writes always go through Admin
// SDK functions. Membership in platformAdmins is granted via Admin SDK
// (adminSetPlatformAdmin callable or scripts/seed-admin.mjs), never through
// client Firestore writes.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Membership doc: orgs/{orgId}/members/{uid}
    function isOrgMember(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    function isPlatformAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    match /platformAdmins/{uid} {
      // A user may only check their OWN admin status — never enumerate or
      // read other admins' entries.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false; // via Admin SDK (adminSetPlatformAdmin / seed-admin.mjs)
    }

    // Collection-group LIST rule for `members`, declared at the TOP LEVEL
    // with a `{path=**}` wildcard parent. This is deliberate and required:
    // Firestore does NOT reliably apply a `list`/collectionGroup rule from a
    // block NESTED inside `match /orgs/{orgId}` — verified empirically
    // (an unconditional `allow list: if true` nested under orgs/{orgId} was
    // still denied by the emulator for a collectionGroup("members") query).
    // A top-level `{path=**}` match is the documented, working pattern for
    // collection-group queries. This is what lets a user discover "which
    // orgs am I a member of" via collectionGroup("members").where("uid","==",uid).
    // Reading a SPECIFIC known member doc (`get`) is unaffected and stays
    // governed by the richer rule nested under orgs/{orgId}/members below.
    match /{path=**}/members/{uid} {
      allow list: if isSignedIn() && request.auth.uid == uid;
    }

    // Daily Genkit ruleforge reports — platform admins may read; writes via Admin SDK only.
    match /ruleforgeRuns/{day} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // Human approval queue for evolve + new rules (security/dress).
    match /ruleProposals/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // Approved corpus cases extending golden.json for future evolve runs.
    match /ruleforgeCorpus/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // Dress codes / overlay rules — writes via Admin SDK callables only.
    match /dressCodes/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /platformDressRules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Site-wide feature toggles — any signed-in user may READ (so any part
    // of the app can gate a feature), but writes go exclusively through the
    // setFeatureFlag callable (Admin SDK), which itself checks
    // isPlatformAdmin() — never trust a client write here even if this rule
    // were accidentally loosened.
    match /platformFeatureFlags/{flagKey} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Analytical rollups (survive 90-day detail purge). Writes via Admin SDK only.
    match /analyticsDaily/{day} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /analyticsMonthly/{month} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /analyticsRepos/{repoKey} {
      allow read: if isPlatformAdmin()
        || (isSignedIn()
          && resource.data.orgId is string
          && isOrgMember(resource.data.orgId));
      allow write: if false;
    }
    match /analyticsArchives/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // Async ingest queue — Admin SDK / Functions only.
    match /ingestJobs/{jobId} {
      allow read, write: if false;
    }

    // Platform ops (purge / queue) — Admin SDK only; UI uses callables.
    match /platformOpsSettings/{docId} {
      allow read, write: if false;
    }

    match /orgs/{orgId} {
      allow read: if isOrgMember(orgId) || isPlatformAdmin();
      // Org creation/mutation handled by callable functions (Admin SDK).
      allow write: if false;

      match /members/{uid} {
        // `list` (collectionGroup, cross-org) is handled by the top-level
        // `{path=**}/members/{uid}` rule above. This nested rule covers
        // `get` — reading a single known member doc within an org you
        // already belong to (or as a platform admin).
        allow get: if isOrgMember(orgId) || isPlatformAdmin() || (isSignedIn() && request.auth.uid == uid);
        allow write: if false; // managed by functions
      }

      match /projects/{projectId} {
        allow read: if isOrgMember(orgId) || isPlatformAdmin();
        allow write: if false;

        // A project consolidates one or more repos — each repo has its own
        // ingestToken/CI pipeline and metrics; the project doc holds the
        // rolled-up totals (see lib/projectAggregate.ts).
        match /repos/{repoId} {
          allow read: if isOrgMember(orgId) || isPlatformAdmin();
          allow write: if false; // managed by functions

          match /analyses/{analysisId} {
            allow read: if isOrgMember(orgId) || isPlatformAdmin();
            allow write: if false;
          }

          match /issues/{fingerprint} {
            allow read: if isOrgMember(orgId) || isPlatformAdmin();
            allow write: if false;
          }

          match /sddSpecs/{specId} {
            allow read: if isOrgMember(orgId) || isPlatformAdmin();
            allow write: if false;
          }
        }

        match /dressCodes/{id} {
          allow read: if isOrgMember(orgId) || isPlatformAdmin();
          allow write: if false;
        }

        match /dressRules/{ruleId} {
          allow read: if isOrgMember(orgId) || isPlatformAdmin();
          allow write: if false;
        }
      }

      // FP / confirmed labels for rule-motor training — never purged.
      match /ruleforgeFeedback/{id} {
        allow read: if isOrgMember(orgId) || isPlatformAdmin();
        allow write: if false;
      }

      match /sddOutcomes/{id} {
        allow read: if isOrgMember(orgId) || isPlatformAdmin();
        allow write: if false;
      }

      match /settings/{docId} {
        allow read: if isOrgMember(orgId) || isPlatformAdmin();
        allow write: if false;
      }
    }
  }
}
